{
  "name": "Video Uretici Panel Webhook VPS Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-uret",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-video-uret",
      "name": "Panel Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst clipSeconds = Number(body.clipSeconds || 10);\nconst clipCount = Number(body.clipCount || 1);\nconst mainPrompt = body.mainPrompt || '';\nconst sceneText = body.scenePrompts || '';\nlet scenes = sceneText.split('\\n').map(s => s.trim()).filter(Boolean);\nif (!scenes.length) scenes = Array.from({ length: clipCount }, () => mainPrompt);\nwhile (scenes.length < clipCount) scenes.push(mainPrompt);\nscenes = scenes.slice(0, clipCount);\nreturn scenes.map((prompt, index) => ({ json: {\n  index,\n  promptText: prompt,\n  imageUrl: body.imageUrl,\n  musicUrl: body.musicUrl || '',\n  logoUrl: body.logoUrl || '',\n  negativePrompt: body.negativePrompt || '',\n  model: body.model || 'gen4_turbo',\n  ratio: body.ratio || '1280:720',\n  duration: clipSeconds,\n  transition: body.transition || 'fade',\n  caption: body.caption || '',\n  totalClips: clipCount\n}}));"
      },
      "id": "prepare-scenes",
      "name": "Sahneleri Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.dev.runwayml.com/v1/image_to_video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.RUNWAYML_API_SECRET}}"
            },
            {
              "name": "X-Runway-Version",
              "value": "2024-11-06"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": $json.model,\n  \"promptText\": $json.promptText,\n  \"ratio\": $json.ratio,\n  \"duration\": $json.duration,\n  \"promptImage\": $json.imageUrl\n}"
      },
      "id": "runway-create",
      "name": "Runway Klip Üret",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "amount": 25,
        "unit": "seconds"
      },
      "id": "wait-runway",
      "name": "25 Sn Bekle",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.dev.runwayml.com/v1/tasks/{{$json.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.RUNWAYML_API_SECRET}}"
            },
            {
              "name": "X-Runway-Version",
              "value": "2024-11-06"
            }
          ]
        }
      },
      "id": "runway-status",
      "name": "Runway Durum Kontrol",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equals",
              "value2": "SUCCEEDED"
            }
          ]
        }
      },
      "id": "if-succeeded",
      "name": "Klip Hazır mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const url = Array.isArray($json.output) ? $json.output[0] : ($json.output || $json.videoUrl || '');\nreturn [{ json: { videoUrl: url, raw: $json } }];"
      },
      "id": "extract-video-url",
      "name": "Video URL Al",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"message\": \"İlk klip üretimi tamamlandı. Çoklu klip ve final render için Shotstack/FFmpeg toplama adımı canlı testte bağlanacak.\",\n  \"videoUrl\": $json.videoUrl,\n  \"raw\": $json.raw\n}"
      },
      "id": "respond",
      "name": "Panele Yanıt Ver",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1680,
        220
      ]
    }
  ],
  "connections": {
    "Panel Webhook": {
      "main": [
        [
          {
            "node": "Sahneleri Hazırla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sahneleri Hazırla": {
      "main": [
        [
          {
            "node": "Runway Klip Üret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Runway Klip Üret": {
      "main": [
        [
          {
            "node": "25 Sn Bekle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "25 Sn Bekle": {
      "main": [
        [
          {
            "node": "Runway Durum Kontrol",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Runway Durum Kontrol": {
      "main": [
        [
          {
            "node": "Klip Hazır mı?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Klip Hazır mı?": {
      "main": [
        [
          {
            "node": "Video URL Al",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "25 Sn Bekle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Video URL Al": {
      "main": [
        [
          {
            "node": "Panele Yanıt Ver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}