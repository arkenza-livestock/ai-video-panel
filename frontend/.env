# ==================== TEMEL AYARLAR ====================
SECRET_KEY=atmosfer-pro-super-secret-key-2024-advanced
DEBUG=true
ENVIRONMENT=production

# ==================== VERİTABANI ====================
DATABASE_URL=postgresql://atmosfer:atmosfer123@postgres:5432/atmosfer
POSTGRES_DB=atmosfer
POSTGRES_USER=atmosfer
POSTGRES_PASSWORD=atmosfer123

# ==================== REDIS (Cache & Message Broker) ====================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_QUEUE_URL=redis://redis:6379/2

# ==================== CELERY ====================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==================== API AYARLARI ====================
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3008", "http://72.62.186.96"]
API_RATE_LIMIT=100

# ==================== YOUTUBE API ====================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# ==================== PEXELS API (Görsel) ====================
PEXELS_API_KEY=
PEXELS_API_URL=https://api.pexels.com/v1

# ==================== PIXABAY API (Görsel/Müzik) ====================
PIXABAY_API_KEY=

# ==================== FFMPEG AYARLARI ====================
FFMPEG_THREADS=4
FFMPEG_PRESET=medium
MAX_VIDEO_DURATION=36000
MAX_FILE_SIZE=536870912

# ==================== STORAGE ====================
OUTPUT_DIR=output
TEMP_DIR=temp
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=536870912

# ==================== GÜVENLİK ====================
JWT_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ==================== E-POSTA (Şifre sıfırlama vb.) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@atmosfer.studio

# ==================== LOGLAR ====================
LOG_LEVEL=info
LOG_FILE=logs/atmosfer.log

# ==================== ÖZEL ATMOSFER AYARLARI ====================
WATERMARK_TEXT=Atmosfer Stüdyo Pro
WATERMARK_POSITION=bottom-right
DEFAULT_DURATION=180
DEFAULT_RESOLUTION=1920x1080
DEFAULT_FPS=30
DEFAULT_BITRATE=5M
